${cacheDir}/wallbash/tmux.conf|${WALLBASH_SCRIPTS}/tmux.sh
# Autogenerated by wallbash from the current wallpaper -- do not edit.
# Sourced at the end of ~/.tmux.conf, after tpm, so it wins over plugin themes.

set -g status on
set -g status-position bottom
set -g status-justify left
set -g status-style "bg=#<wallbash_pry1>,fg=#<wallbash_1xa8>"

set -g status-left-length 40
set -g status-left "#[bg=#<wallbash_pry4>,fg=#<wallbash_txt4>,bold] #S #[bg=#<wallbash_pry1>,fg=#<wallbash_pry4>,nobold] "

set -g status-right-length 80
set -g status-right "#[bg=#<wallbash_1xa2>,fg=#<wallbash_1xa8>] %H:%M #[bg=#<wallbash_pry3>,fg=#<wallbash_txt3>,bold] #h "

setw -g window-status-separator ""
setw -g window-status-format "#[bg=#<wallbash_pry1>,fg=#<wallbash_1xa5>] #I:#W "
setw -g window-status-current-format "#[bg=#<wallbash_pry3>,fg=#<wallbash_txt3>,bold] #I:#W "
setw -g window-status-activity-style "bg=#<wallbash_1xa3>,fg=#<wallbash_1xa9>"

set -g pane-border-style "fg=#<wallbash_1xa3>"
set -g pane-active-border-style "fg=#<wallbash_pry4>"

set -g message-style "bg=#<wallbash_pry3>,fg=#<wallbash_txt3>"
set -g message-command-style "bg=#<wallbash_pry3>,fg=#<wallbash_txt3>"
set -g mode-style "bg=#<wallbash_pry4>,fg=#<wallbash_txt4>"

set -g display-panes-active-colour "#<wallbash_pry4>"
set -g display-panes-colour "#<wallbash_1xa4>"
set -g clock-mode-colour "#<wallbash_pry4>"
