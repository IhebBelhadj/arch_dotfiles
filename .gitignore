# --- Generated by HyDE / wallbash (regenerated from the active wallpaper+theme) ---
**/.config/hypr/themes/
**/.config/hypr/animations.conf
**/.config/hypr/hyprlock.conf
**/.config/hypr/hyprlock/
**/.config/hypr/shaders/
**/.config/waybar/config.jsonc
**/.config/waybar/style.css
**/.config/waybar/theme.css
**/.config/waybar/includes/
**/.config/waybar/layouts/
**/.config/waybar/menus/
**/.config/kitty/hyde.conf
**/.config/kitty/theme.conf
**/.config/vim/colors/wallbash.vim

# --- Shell state / caches, never config ---
**/.zsh_history
**/.zcompdump*
**/.config/zsh/conf.d/
**/.config/zsh/functions/
**/.config/zsh/completions/

# --- Neovim runtime state (plugins are restored from lazy-lock.json) ---
nvim/.config/nvim/lazy-lock.json.bak
**/.config/nvim/spell/

# --- General ---
*.swp
*.bak
*~
